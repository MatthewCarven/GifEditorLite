# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Scratch — test GIFs live here, not in the repo
scratch/
*.tmp

# Commit messages I leave for you when the sandbox can't commit itself
COMMIT_MSG.txt

# Sample GIFs dropped in the project root (Matthew's test assets). Ignored at
# root so they aren't committed by accident; if we want them tracked as
# fixtures they move to tests/fixtures/, which is NOT ignored.
/*.gif

# Same rule for screenshots at root — `git add -A` has swept one into a
# commit twice now (2026-08-01 amended, 2026-08-03 shipped). Anything worth
# tracking gets a real home first.
/*.png
/*.gifproj
